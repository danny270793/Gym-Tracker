    "settingsPrivacyInfraBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your weekly plan, exercises, workout logs and reference photos are stored in Supabase, tied to your account and protected so only you can read them. A copy of the last data loaded is kept on this device to show it offline, and is deleted when you sign out. Security and backups depend on that service. Use a strong password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan semanal, ejercicios, registros de entrenamiento y fotos de referencia se guardan en Supabase, asociados a tu cuenta y protegidos para que solo tú puedas leerlos. En este dispositivo se guarda una copia de los últimos datos cargados para verlos sin conexión, y se borra al cerrar sesión. La seguridad y los respaldos dependen de ese servicio. Usa una contraseña segura."
          }
        }
      }
    },
    "settingsPrivacyInfraTitle" : {
      "extractionState" : "manual",
